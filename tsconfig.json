{
    "compilerOptions": {
      "target": "es2018",
      "module": "commonjs",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "moduleResolution": "node",
      "resolveJsonModule": true,
      "baseUrl": ".",
      "paths": {
        "*": ["tests/*"]
      }
    },
    "include": [
      "tests/steps/**/*.ts",
      "tests/features/**/*.ts",
    ],
    "exclude": [
      "node_modules"
    ]
  }