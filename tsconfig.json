{
    "compilerOptions": {
      "target": "es2018",
      "module": "commonjs",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "moduleResolution": "node",
      "resolveJsonModule": true,
      "baseUrl": ".",
      "paths": {
        "*": ["*", "src/*"]
      }
    },
    "include": [
      "steps/**/*.ts",
      "src/**/*.ts",
      "features/**/*.ts"
    ],
    "exclude": [
      "node_modules"
    ]
  }